{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fresh-cbm state cache manifest",
  "type": "object",
  "required": [
    "schema",
    "dataset",
    "package",
    "package_fingerprint",
    "libcbm_version",
    "cbm_defaults_sha256",
    "years",
    "dtype",
    "accounts",
    "offsets",
    "empty",
    "states",
    "files"
  ],
  "properties": {
    "schema": {"const": "fresh-cbm-state-v1"},
    "created": {"type": "string"},
    "dataset": {"type": "string", "minLength": 1},
    "package": {"type": "string", "minLength": 1},
    "package_fingerprint": {"type": "string", "minLength": 1},
    "libcbm_version": {"type": "string", "minLength": 1},
    "cbm_defaults_sha256": {"type": "string", "minLength": 1},
    "years": {"type": "integer", "minimum": 1},
    "dtype": {"enum": ["float32", "float64"]},
    "accounts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "offsets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "empty": {"type": "boolean"},
    "states": {"type": "integer", "minimum": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "build_seconds": {"type": "number", "minimum": 0},
    "hwp_config": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
